{
  "name": "opencanvas",
  "version": "0.1.0",
  "description": "OpenCanvas — runtime visual multiagente, local-first. Core agnóstico + MCP + adapters + React renderer.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencanvas": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:core": "tsc -p tsconfig.json",
    "dev:web": "vite",
    "serve": "node dist/runtime/server.js",
    "mcp": "node dist/mcp/server.js",
    "test": "npm run build:core && node --test \"dist/tests/*.test.js\"",
    "test:all": "npm run build:core && node --test \"dist/tests/*.test.js\"",
    "doctor": "node dist/cli/index.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opencode/plugin": "2.0.26",
    "marked": "^15.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
